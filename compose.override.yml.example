# これを compose.override.yml にコピーして自分の情報を記入する。
# compose.override.yml は docker compose が自動で読み込む (gitignore済み)。
services:
  kot:
    environment:
      # ログインURL(会社によって s2/s3 などが異なる。ブラウザでいつも使うURL)
      KOT_LOGIN_URL: https://s3.kingtime.jp/independent/
      KOT_ID: your_login_id
      KOT_PASSWORD: your_password

      # 申請理由(打刻申請時に必須の場合が多い)
      REQUEST_REMARK: 勤怠自動入力

      # 実働がこの時間に満たない日は、推定の休憩を外して出勤〜退勤だけで申請する。
      # (会議やコーディングでログが少ない日は、働いていた時間が休憩として推定されるため)
      # 未設定なら無効。
      # MIN_WORK_HOURS: "8"
